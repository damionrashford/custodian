{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.test.ts", "scripts/*.ts"],
      "project": ["tests/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/main.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
