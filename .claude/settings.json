{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GRAPHIFY_OUT": "/Users/damionrashford/Projects/prod-agent/.graphify"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(npx *)",
      "Bash(npm *)",
      "Bash(playwright-cli *)",
      "Bash(uv *)",
      "Bash(gh *)",
      "Bash(textutil *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(test *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Write",
      "Edit",
      "Skill",
      "WebFetch",
      "Workflow"
    ],
    "ask": [
      "Edit(.research/**)",
      "Write(.research/**)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Write(./secrets/**)",
      "Write(./credentials/**)",
      "Edit(./secrets/**)",
      "Edit(./credentials/**)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"[\\(.model.display_name)] \\(.context_window.used_percentage // 0)% context\"'",
    "padding": 2
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "adversaria@damionrashford-adversaria": true
  }
}
