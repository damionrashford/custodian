{
  "name": "custodian",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "layers": "depcruise packages tests scripts --config .dependency-cruiser.cjs",
    "deadcode": "knip",
    "structure": "bun scripts/check-structure.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "gate:erasure": "bun test tests/erasure-acceptance.test.ts",
    "verify": "bun run typecheck && bun run lint && bun run layers && bun run deadcode && bun run structure && bun run format && bun run test"
  },
  "dependencies": {},
  "devDependencies": {
    "@custodian/agent-loop": "workspace:*",
    "@custodian/config-registry": "workspace:*",
    "@custodian/context-assembly": "workspace:*",
    "@custodian/crypto-shred": "workspace:*",
    "@custodian/domain-primitives": "workspace:*",
    "@custodian/durable-execution": "workspace:*",
    "@custodian/erasure": "workspace:*",
    "@custodian/eval": "workspace:*",
    "@custodian/event-delivery": "workspace:*",
    "@custodian/execution-log": "workspace:*",
    "@custodian/gateway": "workspace:*",
    "@custodian/guardrails": "workspace:*",
    "@custodian/idempotency": "workspace:*",
    "@custodian/identity": "workspace:*",
    "@custodian/knowledge-base": "workspace:*",
    "@custodian/memory": "workspace:*",
    "@custodian/metering": "workspace:*",
    "@custodian/oversight": "workspace:*",
    "@custodian/reconciliation": "workspace:*",
    "@custodian/response-cache": "workspace:*",
    "@custodian/retention": "workspace:*",
    "@custodian/retrieval": "workspace:*",
    "@custodian/routing": "workspace:*",
    "@custodian/streaming": "workspace:*",
    "@custodian/tool-registry": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.4.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "knip": "^6.33.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
