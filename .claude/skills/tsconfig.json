{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"],
    "typeRoots": [
      "/Users/damionrashford/.bun/install/global/node_modules/@types"
    ]
  },
  "include": ["**/scripts/**/*.ts"],
  "exclude": ["**/node_modules/**"]
}
