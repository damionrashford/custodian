node_modules/
.env
.env.*
!.env.example

# bun test
/coverage/

# Machine setup stays local; the standards and reviewer definitions do not. Everything under
# /.claude/ that carries an absolute path — settings.json (GRAPHIFY_OUT), hooks/ (a binary path),
# skills/ (103M of vendored corpus), worktrees/ — is local. rules/ and agents/ are the rules a
# change is judged against, and a clone that cannot read them cannot follow them.
/.claude/*
!/.claude/rules/
!/.claude/agents/
CLAUDE.local.md
/.research/
/.graphify/

# superpowers plugin working state. .superpowers/brainstorm/ holds a live session
# token (.last-token); the plugin only self-ignores .superpowers/sdd/, so ignore the root.
/.superpowers/
/.worktrees/
# studio design system — local-only artifacts (do not commit)
design/drafts/
design/.merge.lock
design/reports/
.studio/
