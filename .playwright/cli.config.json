{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true
    },
    "contextOptions": {
      "viewport": { "width": 1920, "height": 1080 }
    }
  },
  "outputDir": ".playwright/output",
  "outputMode": "stdout",
  "console": {
    "level": "info"
  },
  "testIdAttribute": "data-testid",
  "timeouts": {
    "action": 5000,
    "navigation": 60000
  },
  "allowUnrestrictedFileAccess": false,
  "codegen": "typescript"
}
